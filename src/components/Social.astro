---
const { site, username, itch } = Astro.props;
---

<a href={itch?`https://${username}.${site}.io`:`https://www.${site}.com/@${username}`}>{site}</a>

<style>
    a {
        padding: 0.5rem 1rem;
        color: #1f0740;
        background-color: #ffbb3b;
        text-decoration: none;
        font-weight: 600;
        transition: 200ms ease;
    }

    a:hover {
        background-color: #561dac;
        color: #ffbb3b;
    }
</style>