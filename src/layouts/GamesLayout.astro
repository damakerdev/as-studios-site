---
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import logo from '../../public/logo.png';
import Menu from "../components/Menu.astro";
import Navigation from "../components/Navigation.astro";
const { frontmatter } = Astro.props;
---
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{frontmatter.title} | AS Studios</title>
	</head>
<article>
    <nav>
        <Menu />
        <Navigation />
    </nav>
    <h1>{frontmatter.title}</h1>
    <div class="sub-info">
        <p>Published on: {frontmatter.pubDate.toString().slice(0,10)}</p>
        <p>{frontmatter.description}</p>
        <p>Written by {frontmatter.author}</p>
    </div>
    <div class="content">
        <slot />
        <h3>Image</h3>
        <img class="game-img" src={frontmatter.image.url} width="240" alt={frontmatter.image.alt}>
    </div>
    <Footer />
    <script>
			const menu =document.querySelector('.menu')
			menu?.addEventListener('click',()=>{
				const expanded=menu.getAttribute('aria-expanded')==='true';
				menu.setAttribute('aria-expanded',`${!expanded}`);
			})
    </script>
</article>

<style is:global>

    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Literata:wght@400;700&display=swap');

    html {
        background-color: #1f0740;
        color: #ffffff;
    }

    * {
        margin: 0;
        padding: 0;
    }

    body {
        padding: 1rem;
        display: flex;
        align-items: center;
        flex-direction: column;
        line-height: 1.5;
        font-family: 'Literata',sans-serif;
    }

    nav {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    article {
        display: flex;
        align-items: center;
        flex-direction: column;
        gap: 10px;
        font-family: 'Literata', sans-serif;
    }

     h1 {
        text-align: center;
        font-size: 3rem;
        font-family: 'Instrument Serif', serif;
    }

    h1:hover {
        text-decoration: underline;
        text-decoration-style: wavy;
        text-decoration-color: #ffbb3b;
    }

    .sub-info {
        background-color: #1f0740;
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        font-size: 0.9rem;
        margin-bottom: 40px;
        justify-content: center;
        flex-direction: column;
        border: 2px #561dac solid;
        color: #c7a2ff;
        transition: 200ms ease;
    }

    .sub-info:hover {
        border-bottom-right-radius: 20px;
        border-bottom-left-radius: 20px;
    }

    .game-img {
        border: 2px solid #ffbb3b;
        align-self: center;
    }

    .content {
        width: 800px;
        display: flex;
        flex-direction: column;
        gap: 0;
        line-height: 1.5;
    }

    .content h3 {
        font-size: 2rem;
        align-self: center;
        color: #ffbb3b;
        margin-top: 2rem;
        margin-bottom: 0.5rem;
    }

    .content h3:hover {
        text-decoration: underline;
        text-decoration-style: wavy;
        text-decoration-color: #ffffff;
    }

    p {
        margin: 0.25rem 0;
    }

    .content a {
        text-decoration: none;
        color: #ffbb3b;
    }

    .content a:hover, .content a:focus {
        text-decoration: underline;
        text-decoration-style: wavy;
    }

    .mobile {
        display: block !important;
    }

    .desktop {
        display: none !important;
    }

    .menu {
        font-family: 'Literata',sans-serif;
        background-color: #561dac;
        border: none;
        color: #ffffff;
        padding: 5px 10px;
        font-size: 1rem;
        font-weight: bold;
    }

    .menu:hover {
        background-color: #ffbb3b;
        color:#561dac;
    }

    .nav-links {
        width: 100%;
        margin: 0;
        display: none;
    }

    .nav-links a {
        display: block;
        text-align: center;
        padding: 10px 0;
        text-decoration: none;
        font-size: 1rem;
        font-weight: bold;
        text-transform: uppercase;
        color: #ffffff;
        transition: 200ms ease;
    }

    .nav-links a:hover, .nav-links a:focus {
        background-color: #ffbb3b;
        color: #1f1f1f;
    }

    :has(.menu[aria-expanded="true"]) .nav-links {
        display: unset;
    }

    @media screen and (min-width: 720px){
        .nav-links {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 3rem;
        }

        .nav-links a{
            padding: 15px 20px;
        }
        
        .menu {
            display: none ;
        }

        .mobile {
            display: none !important;
        }

        .desktop {
            display: block !important;
        }

        .desktop:hover {
            background-color: #1f0740 !important;
        }
    }
</style>