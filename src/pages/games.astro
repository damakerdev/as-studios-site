---
import Layout from "../layouts/Layout.astro";

const allGames = Object.values(import.meta.glob('./games/*.md',{eager: true}))
const pageTitle="Games"
---


<Layout pageTitle={pageTitle}>
	<h1>{pageTitle}</h1>
    <ul>
        <!-- <li><a href="/games/candyland">Candyland</a></li>
        <li><a href="/games/spiritbruh">SpiritBruh</a></li> -->
        {allGames.map((games:any)=><li><a href={games.url}>{games.frontmatter.title}</a></li>)}
    </ul>
</Layout>

<style>
    ul {
        list-style-type: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 2rem;
    }

    li {
        background-color: #571eac;
        padding: 15px 20px;
        transition: 200ms ease;
    }

    li:hover {
        border-bottom-left-radius: 20px;    
        border-bottom-right-radius: 20px;    
        background-color: #390a80;
        box-shadow: 0px 4px #390a80, 0px 12px #6c22db;
    }

    a {
        color: #ffbb3b;
        text-decoration: none;
        font-weight: bold;
    }

</style>